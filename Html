<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ระบบใบเสนอราคา AI - Soft Premium UI</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600&family=Prompt:wght@300;400;500;600&display=swap');

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
    }

    body {
      min-height: 100vh;
      /* พื้นหลังสีเบจ/ครีมอุ่น นุ่มนวลเหมือนภาพตัวอย่าง */
      background: #e8e2d9;
      background-image: 
        radial-gradient(at 10% 10%, rgba(255, 255, 255, 0.8) 0px, transparent 50%),
        radial-gradient(at 90% 90%, rgba(210, 195, 178, 0.5) 0px, transparent 50%);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
      color: #33322e;
    }

    /* Container หลักทรงการ์ดใสโทนอุ่น */
    .app-card {
      width: 100%;
      max-width: 920px;
      background: rgba(245, 241, 235, 0.75);
      backdrop-filter: blur(30px) saturate(140%);
      -webkit-backdrop-filter: blur(30px) saturate(140%);
      border-radius: 36px;
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 
        0 30px 60px rgba(166, 150, 133, 0.25),
        inset 0 1px 2px rgba(255, 255, 255, 0.9);
      padding: 40px;
    }

    .header-title {
      font-size: 24px;
      font-weight: 500;
      color: #24221e;
      margin-bottom: 24px;
      letter-spacing: -0.3px;
    }

    /* โซน Upload รูปภาพสไตล์ Soft Capsule */
    .upload-box {
      background: rgba(255, 255, 255, 0.5);
      border-radius: 24px;
      padding: 16px 24px;
      border: 1px solid rgba(255, 255, 255, 0.6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 32px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    }

    /* ปุ่มกดสไตล์ Capsule สีดำนวลทรงเดียวกับในภาพ */
    .pill-btn {
      background: #1a1917;
      color: #ffffff;
      border: none;
      padding: 12px 28px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s ease;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
    }

    .pill-btn:hover {
      background: #33312c;
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    label {
      font-size: 13px;
      font-weight: 500;
      color: #78736a;
      margin-left: 8px;
    }

    /* Input สไตล์ Soft Pill */
    input[type="text"], input[type="number"] {
      width: 100%;
      padding: 14px 20px;
      background: rgba(255, 255, 255, 0.65);
      border: 1px solid rgba(220, 212, 200, 0.6);
      border-radius: 50px;
      color: #2c2a26;
      font-size: 15px;
      outline: none;
      transition: all 0.2s ease;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    input:focus {
      background: #ffffff;
      border-color: #b0a494;
      box-shadow: 0 0 0 3px rgba(176, 164, 148, 0.2);
    }

    /* ตารางสไตล์ Clean Minimal Glass */
    .table-container {
      background: rgba(255, 255, 255, 0.4);
      border-radius: 24px;
      padding: 12px;
      border: 1px solid rgba(255, 255, 255, 0.7);
      margin-bottom: 28px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      text-align: left;
      padding: 14px 16px;
      color: #8c857b;
      font-weight: 500;
      font-size: 13px;
      border-bottom: 1px solid rgba(210, 200, 185, 0.4);
    }

    td {
      padding: 8px 6px;
    }

    td input {
      border-radius: 16px !important; /* ตารางใช้ทรงมนนุ่มนวล */
      padding: 10px 14px !important;
      background: rgba(255, 255, 255, 0.8) !important;
    }

    .total-container {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 16px;
      background: rgba(255, 255, 255, 0.5);
      padding: 16px 24px;
      border-radius: 50px;
      border: 1px solid rgba(255, 255, 255, 0.7);
    }

    .total-container span {
      font-size: 15px;
      font-weight: 500;
      color: #57524a;
    }

    .total-container input {
      width: 160px;
      font-weight: 600;
      font-size: 18px;
      text-align: right;
      color: #1a1917;
      background: #ffffff;
    }
  </style>
</head>
<body>

  <div class="app-card">
    <div class="header-title">ใบเสนอราคา / AI Document Reader</div>
    
    <!-- ปุ่มอัปโหลดสไตล์ Pill -->
    <div class="upload-box">
      <input type="file" id="imageInput" accept="image/*" style="border:none; background:transparent; box-shadow:none; padding:0;">
      <button class="pill-btn" onclick="uploadImage()">
        <span>สแกนข้อมูลด้วย AI</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>

    <div id="status" style="margin-bottom: 15px; font-size: 14px; color: #78736a;"></div>

    <!-- ฟอร์มข้อมูล -->
    <div class="grid-2">
      <div class="form-group">
        <label>ชื่อลูกค้า / บริษัท</label>
        <input type="text" id="customerName" placeholder="ระบุชื่อลูกค้า">
      </div>
      <div class="form-group">
        <label>วันที่</label>
        <input type="text" id="date" placeholder="DD/MM/YYYY">
      </div>
    </div>

    <!-- ตารางรายการสินค้า/บริการ -->
    <div class="table-container">
      <table id="itemsTable">
        <thead>
          <tr>
            <th style="width: 45%;">รายการ</th>
            <th style="width: 15%;">จำนวน</th>
            <th style="width: 20%;">ราคา/หน่วย</th>
            <th style="width: 20%;">ราคารวม</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><input type="text" value="งานติดตั้งผ้าใบแรงดึงสูง"></td>
            <td><input type="number" value="1"></td>
            <td><input type="number" value="15000"></td>
            <td><input type="number" value="15000"></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- สรุปยอดรวม -->
    <div class="total-container">
      <span>ยอดรวมสุทธิ</span>
      <input type="number" id="totalAmount" value="15000">
    </div>
  </div>

  <script>
    async function uploadImage() {
      const fileInput = document.getElementById('imageInput');
      const status = document.getElementById('status');
      
      if (!fileInput.files[0]) {
        alert("กรุณาเลือกไฟล์ภาพก่อนครับ");
        return;
      }

      status.innerText = "⏳ กำลังประมวลผลด้วย AI...";
      const formData = new FormData();
      formData.append("file", fileInput.files[0]);

      try {
        const response = await fetch('/extract-quotation', {
          method: 'POST',
          body: formData
        });
        const data = await response.json();

        document.getElementById('customerName').value = data.customer_name || '';
        document.getElementById('date').value = data.date || '';
        document.getElementById('totalAmount').value = data.total_amount || 0;

        const tbody = document.getElementById('itemsTable').querySelector('tbody');
        tbody.innerHTML = '';

        data.items.forEach(item => {
          const row = `<tr>
            <td><input type="text" value="${item.description}"></td>
            <td><input type="number" value="${item.quantity}"></td>
            <td><input type="number" value="${item.unit_price}"></td>
            <td><input type="number" value="${item.amount}"></td>
          </tr>`;
          tbody.innerHTML += row;
        });

        status.innerText = "✨ ดึงข้อมูลสำเร็จ!";
      } catch (err) {
        status.innerText = "❌ เกิดข้อผิดพลาด";
        console.error(err);
      }
    }
  </script>
</body>
</html>
